{
  "manifest_version": 3,
  "name": "YouTube Downloader",
  "version": "1.0.0",
  "description": "Fügt YouTube-Videoseiten einen Download-Button hinzu: Video als MP4 oder Audio als MP3 speichern.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-downloader@tobias.local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["lib/yt-extract.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["lib/lamejs.js", "mp4.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
